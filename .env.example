DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-development-password
DB_NAME=TimeGoBetter

# Servidor
PORT=8080
GIN_MODE=debug
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OPERATOR_KEY=replace-with-a-private-operator-key
# Cuenta administrativa inicial. Configura ambas variables solo para crear o
# recuperar el administrador de este entorno; no se expone en el registro.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Administrador
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
